          },
          "amenities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AmenityResponseDto"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "photos",
          "id",
          "ownerId",
          "title",
          "description",
          "status",
          "country",
          "city",
          "address",
          "latitude",
          "longitude",
          "pricePerNight",
