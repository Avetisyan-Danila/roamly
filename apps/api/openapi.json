          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "AmenityResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ]
      },
      "DraftPropertyResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "DRAFT"
            ],
            "type": "string"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "nullable": true
          },
          "pricePerNight": {
            "type": "string",
            "nullable": true
          },
          "currency": {
            "nullable": true,
            "enum": [
              "EUR",
              "USD",
              "GBP",
              "AMD",
              "RUB"
            ],
            "type": "string"
          },
          "maxGuests": {
            "type": "number",
            "nullable": true
          },
          "bedrooms": {
            "type": "number",
            "nullable": true
          },
          "beds": {
            "type": "number",
            "nullable": true
          },
          "bathrooms": {
            "type": "number",
            "nullable": true
          },
          "amenities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AmenityResponseDto"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "ownerId",
          "status",
          "title",
          "description",
          "country",
          "city",
          "address",
          "latitude",
          "longitude",
          "pricePerNight",
          "currency",
          "maxGuests",
          "bedrooms",
          "beds",
          "bathrooms",
          "amenities",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdatePropertyDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 5000
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "pricePerNight": {
            "type": "string",
            "pattern": "^(?!0+(?:\\.0{1,2})?$)\\d{1,8}(?:\\.\\d{1,2})?$"
          },
          "currency": {
            "enum": [
              "EUR",
              "USD",
              "GBP",
              "AMD",
              "RUB"
            ],
            "type": "string"
          },
          "maxGuests": {
            "type": "number",
            "minimum": 1
          },
          "bedrooms": {
            "type": "number",
            "minimum": 0
          },
          "beds": {
            "type": "number",
            "minimum": 1
          },
          "bathrooms": {
            "type": "number",
            "minimum": 0.5
          },
          "amenityIds": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CreatePhotoUploadUrlDto": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "sizeBytes": {
            "type": "number",
            "minimum": 1,
            "maximum": 10485760
          }
        },
        "required": [
          "contentType",
          "sizeBytes"
        ]
      },
      "PhotoUploadUrlResponseDto": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string"
          },
          "uploadUrl": {
            "type": "string"
          }
        },
        "required": [
          "uploadId",
          "uploadUrl"
        ]
      },
      "ConfirmedPhotoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "PropertyPhotoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "position": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "url",
          "position"
        ]
      },
      "PropertyDetailsResponseDto": {
        "type": "object",
        "properties": {
          "photos": {
            "type": "array",
